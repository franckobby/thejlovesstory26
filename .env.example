# Passcode for the /admin page. Defaults to a built-in value if unset — set your
# own here locally, and in your Vercel environment variables for production.
ADMIN_PASSCODE=change-me

# Production persistence: injected automatically when you create a Neon Postgres
# database in the Vercel Storage tab, or paste your Neon connection string here.
# Leave unset locally to use the data/*.json files.
# DATABASE_URL=
