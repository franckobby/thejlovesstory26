# Copy to .env.local and set your own value.
# Password that protects the private /admin seating editor.
ADMIN_PASSWORD=change-me

# Production persistence (Vercel). These are injected automatically when you
# create a Redis (KV) store in the Vercel Storage tab and connect it to the
# project. Leave them unset locally — the app falls back to the data/*.json
# files for local development.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
